# Kopier denne filen til .env og fyll inn. .env skal ALDRI legges i git (den står i .gitignore).

# Nettsidens adresse. Brukes i lenkene i e-postvarslene.
SITE_URL=https://www.example.com

# --- E-postvarsel ved nye henvendelser (SMTP) ---
# Bruk SMTP-innstillingene fra e-postleverandøren eller webhotellet ditt.
# Gmail: smtp.gmail.com, port 587, og et «app-passord» (krever totrinnsbekreftelse), ikke det vanlige passordet.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Sett til 1 hvis leverandøren bruker SSL på port 465
SMTP_SECURE=0
SMTP_USER=noreply@example.com
SMTP_PASS=
# Avsenderen som vises i e-posten, f.eks.: "Firmanavn <noreply@example.com>"
MAIL_FROM=

# For testing uten SMTP: skriv e-postene i terminalen i stedet for å sende dem
# MAIL_LOG=1

# I produksjon bak https/proxy:
# COOKIE_SECURE=1
# TRUST_PROXY=1
